---
import Logo from './Logo.astro';
import { business, telUrl } from '../data/business';

const links = [
  { href: '#obras', label: 'Obras' },
  { href: '#oficio', label: 'Oficio' },
  { href: '#proceso', label: 'Cómo trabajo' },
];
---
<header class="sticky top-0 z-40 border-b border-junta/80 bg-cal/90 backdrop-blur-sm">
  <div class="mx-auto flex h-16 max-w-[90rem] items-center justify-between gap-6 px-4 sm:px-8">
    <a href="/" class="flex items-center gap-3">
      <Logo variant="mark" class="h-7" />
      <span class="text-lg font-bold leading-none tracking-tight">AMM <span class="font-medium">Reformas</span></span>
      <span class="sr-only">(inicio)</span>
    </a>
    <nav aria-label="Principal" class="hidden md:block">
      <ul class="flex items-center gap-8">
        {links.map((l) => (
          <li><a href={l.href} class="note py-2 underline-offset-8 hover:underline">{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="flex items-center gap-4">
      <a href={telUrl} class="note hidden tabular-nums lg:inline hover:underline underline-offset-8">{business.phone.display}</a>
      <a href="#presupuesto" class="btn btn-primary min-h-10 py-2">Presupuesto</a>
    </div>
  </div>
</header>
