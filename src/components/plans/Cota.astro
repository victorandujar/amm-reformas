---
/** Línea de cota de plano: extremos con trazo oblicuo y medida centrada. Va dentro de un <svg>. */
interface Props {
  x1: number; y1: number; x2: number; y2: number;
  label: string;
  delay?: number;
}
const { x1, y1, x2, y2, label, delay = 0 } = Astro.props;
const vertical = x1 === x2;
const mx = (x1 + x2) / 2;
const my = (y1 + y2) / 2;
const t = 5;
---
<g class="text-replanteo" stroke="currentColor" stroke-width="1" style={`--d:${delay}`}>
  <line x1={x1} y1={y1} x2={x2} y2={y2} pathLength="1" />
  <line x1={x1 - t} y1={y1 + t} x2={x1 + t} y2={y1 - t} pathLength="1" />
  <line x1={x2 - t} y1={y2 + t} x2={x2 + t} y2={y2 - t} pathLength="1" />
  <text
    x={vertical ? mx + 8 : mx}
    y={vertical ? my : my - 6}
    fill="currentColor"
    stroke="none"
    font-family="JetBrains Mono, monospace"
    font-size="10"
    text-anchor={vertical ? 'start' : 'middle'}
    dominant-baseline={vertical ? 'middle' : 'auto'}
  >{label}</text>
</g>
