---
import Cota from './Cota.astro';

/** Planta de cocina en L, 3,20 × 2,40 m (1 m = 80 u). */
interface Props { class?: string; animate?: boolean; title: string }
const { class: cls = '', animate = false, title } = Astro.props;
---
<svg viewBox="0 0 340 270" class:list={[cls, animate && 'draw']} role="img" aria-labelledby="kitchen-t" fill="none" stroke-linecap="square">
  <title id="kitchen-t">{title}</title>
  <g stroke="currentColor">
    <path pathLength="1" stroke-width="2.5" d="M40 40 H120 M200 40 H296 V232 H200 M140 232 H40 Z" />
    <path pathLength="1" stroke-width="1" d="M32 32 H120 M200 32 H304 V240 H200 M140 240 H32 Z" />
    <!-- Ventana -->
    <path pathLength="1" stroke-width="1" d="M120 32 V40 M200 32 V40 M120 36 H200" />
    <!-- Encimera en L, fondo 0,60 -->
    <path pathLength="1" stroke-width="1.25" d="M44 44 H292 V92 H92 V228 H44 Z" style="--d:300" />
    <!-- Fregadero bajo ventana -->
    <rect pathLength="1" stroke-width="1" x="138" y="50" width="44" height="34" rx="3" style="--d:500" />
    <!-- Placa: 4 fuegos -->
    <g stroke-width="1" style="--d:600">
      <circle pathLength="1" cx="56" cy="128" r="8" /><circle pathLength="1" cx="80" cy="128" r="6" />
      <circle pathLength="1" cx="56" cy="156" r="6" /><circle pathLength="1" cx="80" cy="156" r="8" />
    </g>
    <!-- Frigorífico -->
    <rect pathLength="1" stroke-width="1.25" x="244" y="44" width="48" height="48" style="--d:650" />
    <path pathLength="1" stroke-width="0.75" d="M244 44 L292 92" opacity="0.5" />
    <!-- Puerta -->
    <path pathLength="1" stroke-width="0.75" stroke-dasharray="2 3" d="M200 232 A60 60 0 0 0 140 172 M140 172 V232" style="--d:700" />
  </g>
  <Cota x1={40} y1={16} x2={296} y2={16} label="3,20" delay={900} />
  <Cota x1={318} y1={40} x2={318} y2={232} label="2,40" delay={1000} />
  <Cota x1={110} y1={92} x2={110} y2={44} label="0,60" delay={1100} />
</svg>
