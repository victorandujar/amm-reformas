---
import BathPlan from './plans/BathPlan.astro';
import { business, whatsappUrl } from '../data/business';
---
<section aria-labelledby="hero-t" class="grid-paper relative overflow-hidden border-b border-grafito">
  <div class="mx-auto grid min-h-[calc(100svh-6.5rem)] max-w-[90rem] grid-cols-12 px-4 pb-10 pt-8 sm:px-8 sm:pb-14">
    <!-- Plano de fondo: ocupa la composición, no "la mitad derecha" -->
    <div class="pointer-events-none absolute inset-y-0 right-[-18%] w-[115%] text-grafito opacity-55 sm:right-[-4%] sm:w-[76%] lg:right-[1%] lg:w-[58%]" aria-hidden="true">
      <BathPlan state="despues" animate uid="hero" title="Planta de un baño reformado" class="h-full w-full" />
    </div>

    <!-- Cota vertical que "mide" el titular -->
    <div class="relative col-span-1 hidden sm:flex" aria-hidden="true">
      <div class="flex h-full flex-col items-center">
        <span class="h-3 w-3 border-t border-replanteo"></span>
        <span class="w-px flex-1 bg-replanteo"></span>
        <span class="note my-3 text-replanteo [writing-mode:vertical-rl] rotate-180">Sant Boi de Llobregat</span>
        <span class="w-px flex-1 bg-replanteo"></span>
        <span class="h-3 w-3 border-b border-replanteo"></span>
      </div>
    </div>

    <div class="relative col-span-12 flex flex-col justify-between gap-12 sm:col-span-11">
      <p class="note flex flex-wrap gap-x-4 gap-y-1 text-mortero">
        <span>{business.owner}</span><span aria-hidden="true" class="text-replanteo">/</span><span>Reformas y albañilería</span>
      </p>

      <h1 id="hero-t" class="display text-[clamp(2.75rem,12.2vw,10rem)]">
        <span class="block">Baños.</span>
        <span class="block pl-[0.3em] sm:pl-[0.6em]">Cocinas.</span>
        <span class="block">Obra<span class="text-replanteo">.</span></span>
      </h1>

      <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
        <p class="max-w-md text-lg leading-snug sm:text-xl">
          Reformo baños y cocinas en Sant Boi y alrededores. Voy a ver la obra, la medimos y te paso el presupuesto por escrito.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="#presupuesto" class="btn btn-primary">Pedir presupuesto <span aria-hidden="true">→</span></a>
          <a href={whatsappUrl('Hola Alberto, quería información sobre una reforma.')} class="btn btn-ghost bg-cal/70" rel="noopener" target="_blank">WhatsApp</a>
        </div>
      </div>
    </div>
  </div>
</section>
