---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BathPlan from './plans/BathPlan.astro';
import KitchenPlan from './plans/KitchenPlan.astro';
import WallElevation from './plans/WallElevation.astro';

interface Props { obra: CollectionEntry<'obras'>; index: number }
const { obra, index } = Astro.props;
const { tipo, titulo, resumen, ejemplo, fotos } = obra.data;
const tipoLabel = { bano: 'Baño', cocina: 'Cocina', albanileria: 'Albañilería' }[tipo];
const n = String(index + 1).padStart(2, '0');
const cover = fotos[0];
---
<article class="group flex w-[82vw] shrink-0 snap-start flex-col sm:w-[30rem] lg:w-[34rem]">
  <div class="relative aspect-[4/5] overflow-hidden border border-grafito bg-cal-2">
    {cover ? (
      <Image src={cover.src} alt={cover.alt} widths={[480, 720, 1080]} sizes="(min-width: 1024px) 34rem, (min-width: 640px) 30rem, 82vw" class="h-full w-full object-cover" loading="lazy" />
    ) : (
      <div class="grid-paper flex h-full items-center justify-center p-8 text-grafito/85">
        {tipo === 'bano' && <BathPlan state="despues" uid={`obra-${n}`} title={`Esquema: ${titulo}`} class="w-full" />}
        {tipo === 'cocina' && <KitchenPlan title={`Esquema: ${titulo}`} class="w-full" />}
        {tipo === 'albanileria' && <WallElevation title={`Esquema: ${titulo}`} class="w-full" />}
      </div>
    )}
    <span class="note absolute left-0 top-0 bg-grafito px-3 py-2 text-cal">Obra {n}</span>
    {ejemplo && (
      <span class="note absolute bottom-0 right-0 border-l border-t border-grafito bg-cal px-3 py-2 text-mortero">Foto real pendiente</span>
    )}
  </div>
  <div class="flex items-baseline justify-between gap-4 border-b border-grafito py-4">
    <h3 class="wide text-xl font-bold uppercase tracking-tight sm:text-2xl">{titulo}</h3>
    <span class="note shrink-0 text-replanteo">{tipoLabel}</span>
  </div>
  <p class="pt-3 text-grafito/80">{resumen}</p>
</article>
