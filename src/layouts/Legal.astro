---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props { title: string; description: string; heading: string }
const { title, description, heading } = Astro.props;
---
<Base title={title} description={description}>
  <Header />
  <main id="contenido" class="mx-auto max-w-3xl px-4 py-20 sm:px-8">
    <h1 class="display text-[clamp(2.25rem,7vw,4rem)]">{heading}</h1>
    <div class="mt-12 space-y-6 text-lg leading-relaxed [&_h2]:wide [&_h2]:mt-12 [&_h2]:text-xl [&_h2]:font-bold [&_h2]:uppercase [&_mark]:bg-replanteo/15 [&_mark]:px-1">
      <slot />
    </div>
  </main>
  <Footer />
</Base>
